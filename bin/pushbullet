#!/bin/bash

set -eu

if [ -z "${PUSHBULLET_ACCESS_TOKEN:-}" ] && command -v secret-tool >/dev/null 2>&1; then
    PUSHBULLET_ACCESS_TOKEN=$(secret-tool lookup service pushbullet 2>/dev/null || true)
fi

if [ -z "${PUSHBULLET_ACCESS_TOKEN:-}" ] && [ -e "$HOME/.config/oreore/pushbullet.sh" ]; then
    source "$HOME/.config/oreore/pushbullet.sh"
fi

if [ -z "${PUSHBULLET_ACCESS_TOKEN:-}" ]; then
    echo 'Please store PUSHBULLET_ACCESS_TOKEN in Secret Service or append it to "$HOME/.config/oreore/pushbullet.sh"'
    echo
    echo "    secret-tool store --label=Pushbullet service pushbullet"
    echo
    echo '    mkdir -pv "$HOME/.config/oreore"'
    echo '    echo export PUSHBULLET_ACCESS_TOKEN=... > "$HOME/.config/oreore/pushbullet.sh"'
    echo
    exit 1
fi

title="$*"
title=${title:-"no title"}
body=

if [ ! -t 0 ]; then
    body="$(cat)"
fi

if type jq >/dev/null 2>&1; then
    data=$(jq -n --arg title "$title" --arg body "$body" '{"type":"note", "title":$title, "body":$body}')
else
    data="{\"type\":\"note\", \"title\":\"$title\", \"body\":\"$body\"}"
fi

curl -sSf -X "POST" "https://api.pushbullet.com/v2/pushes" \
    --header "Authorization: Bearer $PUSHBULLET_ACCESS_TOKEN" \
    --header "Content-Type: application/json" \
    --data-binary "$data" >/dev/null
