#!/bin/bash

# セッション一覧をインデックス順で生成
cmd_list() {
  tmux display -p $'#{S/i:#{session_name}\t\e[90m#{session_windows} windows#{?session_attached, #{session_attached} attached,}\e[0m #T\n,#{session_name}\t\e[90m#{session_windows} windows#{?session_attached, #{session_attached} attached,}\e[0m \e[1;33m(current)\e[0m #T\n}'
}

#tmux display -p ' #{pane_index} : #T '

# ユーザーに確認したうえでセッションを終了
cmd_kill() {
  local session="${1:-}"
  [ -z "$session" ] && return 0
  if gum confirm "kill session: $session"; then
    tmux kill-session -t "$session" \; refresh-client -S
  fi
}

# セッション内の全ウィンドウ（Activeペイン）を横並びでプレビュー表示
cmd_preview() {
  local session="${1:-}"
  [ -z "$session" ] && return 0

  local wins
  wins=$(tmux list-windows -t "$session" -F '#{window_index}:#{window_name}' 2>/dev/null) || return 0

  local num_wins
  num_wins=$(wc -l <<< "$wins")
  [ "$num_wins" -eq 0 ] && return 0

  local lines="${FZF_PREVIEW_LINES:-20}"
  local cols="${FZF_PREVIEW_COLUMNS:-80}"

  if [ "$num_wins" -eq 1 ]; then
    printf "%s\n" "$(tmux capture-pane -ep -t "$session" 2>/dev/null)" | tail -n "$lines"
    return 0
  fi

  python3 - "$session" "$cols" "$lines" << 'EOF'
import sys, subprocess, re, unicodedata

session = sys.argv[1]
cols = int(sys.argv[2])
lines_count = int(sys.argv[3])

ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")

def get_char_width(c):
    if ord(c) < 32:
        return 0
    w = unicodedata.east_asian_width(c)
    return 2 if w in ("F", "W") else 1

def format_line(line, width):
    cur_w = 0
    buf = []
    pos = 0
    for m in ANSI_RE.finditer(line):
        for c in line[pos:m.start()]:
            cw = get_char_width(c)
            if cur_w + cw > width:
                pos = m.start()
                break
            buf.append(c)
            cur_w += cw
        if cur_w >= width:
            break
        buf.append(m.group(0))
        pos = m.end()
    else:
        for c in line[pos:]:
            cw = get_char_width(c)
            if cur_w + cw > width:
                break
            buf.append(c)
            cur_w += cw

    padding = " " * max(0, width - cur_w)
    return "".join(buf) + "\x1b[0m" + padding

try:
    wins_raw = subprocess.check_output(["tmux", "list-windows", "-t", session, "-F", "#{window_index}:#{window_name}"], text=True).strip()
    wins = [w for w in wins_raw.splitlines() if w]
except Exception:
    sys.exit(0)

if not wins:
    sys.exit(0)

num_wins = len(wins)
box_width = max(24, cols // num_wins)
inner_width = box_width - 2
content_lines = max(1, lines_count - 2)

columns_data = []
for w in wins:
    idx, name = w.split(":", 1)
    title_text = f" Window {idx}: {name} "
    title_w = sum(get_char_width(c) for c in title_text)
    if title_w > inner_width:
        top_border = f"\x1b[36m╭\x1b[1;33m{format_line(title_text, inner_width)}\x1b[0;36m╮\x1b[0m"
    else:
        remain_top = inner_width - title_w
        top_border = f"\x1b[36m╭\x1b[1;33m{title_text}\x1b[0;36m" + "─" * remain_top + "╮\x1b[0m"
    bottom_border = "\x1b[36m╰" + "─" * inner_width + "╯\x1b[0m"

    try:
        raw = subprocess.check_output(["tmux", "capture-pane", "-ep", "-t", f"{session}:{idx}"], text=True)
        pane_lines = raw.splitlines()[-content_lines:]
    except Exception:
        pane_lines = []

    if len(pane_lines) < content_lines:
        pane_lines = [""] * (content_lines - len(pane_lines)) + pane_lines

    formatted = [top_border]
    for l in pane_lines:
        formatted.append(f"\x1b[36m│\x1b[0m{format_line(l, inner_width)}\x1b[36m│\x1b[0m")
    formatted.append(bottom_border)
    columns_data.append(formatted)

for row_idx in range(lines_count):
    row_cells = [col[row_idx] for col in columns_data]
    print("".join(row_cells))
EOF
}

case "${1:-}" in
  --list)
    cmd_list
    exit 0
    ;;
  --kill)
    cmd_kill "${2:-}"
    exit 0
    ;;
  --preview)
    cmd_preview "${2:-}"
    exit 0
    ;;
esac

self=${BASH_SOURCE[0]}

# セッション一覧をインデックス順で生成
sessions="$(cmd_list)"

# (current) がある行番号を取得
pos=$(grep -n '(current)' <<<"$sessions")
pos=${pos%%:*}

# fzf に渡し、その行にカーソルを合わせて起動
#
# --preview-window down,follow だとなぜかスクロールしないので $FZF_PREVIEW_LINES で切り取る
# --preview で printf して末尾の空行をトリム
SHELL=/bin/bash fzf --ansi --cycle --reverse --no-input --track -d $'\t' --tabstop=1 --with-nth=1.. --accept-nth=1 --id-nth=1 \
      ${pos:+--bind "load:pos($pos)+unbind(load)"} \
      --bind "x:execute(\"$self\" --kill {1})+reload(\"$self\" --list)" \
      --preview-window down:60% \
      --preview "\"$self\" --preview {1}" \
      <<<"$sessions" \
  | xargs -r tmux switch-client -t
